  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="352" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_4" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="String folder  = (String) globalMap.get(&quot;row1.file_path&quot;);&#xA;String pattern = (String) globalMap.get(&quot;row1.file_name_pattern&quot;);&#xA;if (folder == null || pattern == null) {&#xA;    throw new RuntimeException(&quot;No active config row found for feed &quot; + context.FeedName);&#xA;}&#xA;java.util.Date d = TalendDate.parseDate(&quot;yyyy-MM-dd&quot;, context.FileDate);&#xA;&#xA;java.util.regex.Matcher m = java.util.regex.Pattern.compile(&quot;\\{(.+?)\\}&quot;).matcher(pattern);&#xA;StringBuffer sb = new StringBuffer();&#xA;while (m.find()) {&#xA;    m.appendReplacement(sb, java.util.regex.Matcher.quoteReplacement(&#xA;        new java.text.SimpleDateFormat(m.group(1)).format(d)));&#xA;}&#xA;m.appendTail(sb);&#xA;&#xA;java.io.File f = new java.io.File(folder, sb.toString());&#xA;if (!f.exists()) {&#xA;    throw new RuntimeException(&quot;File not found: &quot; + f.getPath());&#xA;}&#xA;globalMap.put(&quot;fullFilePath&quot;, f.getPath());"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="tJava_resolve"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_4"/>
  </node>
