    <elementParameter field="MEMO_JAVA" name="CODE" value="System.out.println(&quot;Config loaded for &quot; + context.FeedName);&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
