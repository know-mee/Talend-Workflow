  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="832" posY="288">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_3" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="String file = (String) globalMap.get(&quot;fullFilePath&quot;);&#xA;String delimCfg = ((String) globalMap.get(&quot;row1.delimiter_&quot;)).trim();&#xA;char delim = &quot;TAB&quot;.equalsIgnoreCase(delimCfg) ? '\t' : delimCfg.charAt(0);&#xA;String headerVal = String.valueOf(globalMap.get(&quot;row1.has_header&quot;)).trim().toLowerCase();&#xA;boolean hasHeader = headerVal.equals(&quot;t&quot;) || headerVal.equals(&quot;true&quot;) || headerVal.equals(&quot;1&quot;);&#xA;int cfgCount = (Integer) globalMap.get(&quot;row1.field_count&quot;);&#xA;String cfgNames = (String) globalMap.get(&quot;row1.field_names&quot;);&#xA;&#xA;String execId = pid; &#xA;System.out.println(&quot;execution id &quot; + execId);&#xA;&#xA;&#xA;String first;&#xA;try (java.io.BufferedReader br = new java.io.BufferedReader(&#xA;        new java.io.InputStreamReader(new java.io.FileInputStream(file), &quot;UTF-8&quot;))) {&#xA;    first = br.readLine();&#xA;}&#xA;if (first == null) throw new RuntimeException(&quot;File is empty: &quot; + file);&#xA;first = first.replace(&quot;\uFEFF&quot;, &quot;&quot;);                       // strip a UTF-8 BOM&#xA;String[] firstRow = FileUtil.splitLine(first, delim, '&quot;');&#xA;&#xA;String[] cols;&#xA;if (hasHeader) {&#xA;    if (firstRow.length != cfgCount)&#xA;        throw new RuntimeException(&quot;Header has &quot; + firstRow.length + &quot; fields, config expects &quot; + cfgCount);&#xA;    cols = firstRow;&#xA;} else {&#xA;    cols = cfgNames.split(&quot;,&quot;);&#xA;    for (int i = 0; i &lt; cols.length; i++) cols[i] = cols[i].trim();&#xA;    if (cols.length != cfgCount)&#xA;        throw new RuntimeException(&quot;Config field_names has &quot; + cols.length + &quot; names, field_count is &quot; + cfgCount);&#xA;    if (firstRow.length != cfgCount)&#xA;        throw new RuntimeException(&quot;First data row has &quot; + firstRow.length + &quot; fields, config expects &quot; + cfgCount);&#xA;}&#xA;cols = FileUtil.sanitize(cols);&#xA;/*&#xA;String fq = FileUtil.q((String) globalMap.get(&quot;row1.staging_schema&quot;)) + &quot;.&quot; +&#xA;            FileUtil.q((String) globalMap.get(&quot;row1.staging_table&quot;));&#xA;*/&#xA;String baseTable = (String) globalMap.get(&quot;row1.staging_table&quot;);&#xA;String fq = FileUtil.q((String) globalMap.get(&quot;row1.staging_schema&quot;)) + &quot;.&quot; +&#xA;            FileUtil.q(baseTable + &quot;_&quot; + execId);&#xA;&#xA;StringBuilder ddl = new StringBuilder();&#xA;ddl.append(&quot;DROP TABLE IF EXISTS &quot;).append(fq).append(&quot;;\n&quot;);&#xA;ddl.append(&quot;CREATE TABLE &quot;).append(fq).append(&quot; (\n&quot;);&#xA;ddl.append(&quot;  _row_id bigint GENERATED ALWAYS AS IDENTITY,\n&quot;);&#xA;StringBuilder colList = new StringBuilder();&#xA;for (int i = 0; i &lt; cols.length; i++) {&#xA;    ddl.append(&quot;  &quot;).append(FileUtil.q(cols[i])).append(&quot; text,\n&quot;);&#xA;    if (i > 0) colList.append(&quot;, &quot;);&#xA;    colList.append(FileUtil.q(cols[i]));&#xA;}&#xA;ddl.append(&quot;  _load_date timestamp NOT NULL DEFAULT now()\n)&quot;);&#xA;&#xA;String copySql = &quot;COPY &quot; + fq + &quot; (&quot; + colList + &quot;) FROM STDIN WITH (FORMAT csv, HEADER &quot; +&#xA;        (hasHeader ? &quot;true&quot; : &quot;false&quot;) + &quot;, DELIMITER '&quot; + (delim == '\t' ? &quot;\t&quot; : String.valueOf(delim)) +&#xA;        &quot;', QUOTE '\&quot;', ENCODING 'UTF8')&quot;;&#xA;&#xA;System.out.println(&quot;DDL &quot; + ddl.toString());&#xA;System.out.println(&quot;DDL &quot; + copySql.toString());&#xA;System.out.println(&quot;DDL &quot; + fq.toString());&#xA;&#xA;&#xA;&#xA;globalMap.put(&quot;ddlSql&quot;, ddl.toString());&#xA;globalMap.put(&quot;copySql&quot;, copySql);&#xA;globalMap.put(&quot;stagingFq&quot;, fq);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="parse"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_3"/>
  </node>
